# Stage 2：高德地图 JavaScript API（未配置时地图功能不可用）
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=

# Stage 1：本地 Compose 数据库与 JWT（复制为 .env 后填写，不提交）
DB_PASSWORD=
# 至少 32 字节的随机字符串；生产环境应使用更高强度并安全保管
JWT_SECRET=
# HTTPS 部署时设为 true；本地 HTTP Compose 保持 false
SECURE_COOKIE=false

# Stage 5：智能体服务（AI_ENABLED=false 时不调用外部 AI）
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_NAME=
